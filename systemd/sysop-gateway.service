[Unit]
Description=SysOps Engine FastAPI Web Dashboard & REST Gateway
After=network.target

[Service]
Type=simple
User=dgna69
Group=dgna69
WorkingDirectory=/home/dgna69/sysop_engine/modules
EnvironmentFile=/home/dgna69/sysop_engine/modules/.env
ExecStart=/home/dgna69/sysop_engine/venv/bin/uvicorn api_gateway:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
